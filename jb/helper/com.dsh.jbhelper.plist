<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dsh.jbhelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/jbhelper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/jbhelper.out.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/jbhelper.err.log</string>
</dict>
</plist>
